config VIDEO_SUN60I_ISP
	tristate "Allwinner A733 / T527 Hardware ISP (ISP 602) support"
	depends on V4L_PLATFORM_DRIVERS
	depends on VIDEO_DEV && HAS_DMA
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select V4L2_FWNODE
	help
	  This is a driver for the Allwinner A733 / T527 Hardware Image
	  Signal Processor (ISP 602).

	  To compile this driver as a module, choose M here: the module
	  will be called sun60i-isp.
